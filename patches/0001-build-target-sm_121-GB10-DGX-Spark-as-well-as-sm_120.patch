@@ -173,10 +186,10 @@ GpuChoice choose_gpus(const GpuSpec& spec, const std::vector<GpuCard>& visible,
         for (int i = 0; i < n; ++i) {
             if (gpu_main_supported(visible[(size_t) i])) main_ok.push_back(i);
             else if (gpu_peer_supported(visible[(size_t) i])) peer_ok.push_back(i);
-            else c.notes.push_back("gpu auto: " + gpu_label(visible, i) + " skipped, not sm_120");
+            else c.notes.push_back("gpu auto: " + gpu_label(visible, i) + " skipped, not sm_" + std::to_string(BASALT_BUILT_SM));
         }
         if (main_ok.empty()) {
-            c.error = n == 0 ? "gpu auto: no GPU is visible" : "gpu auto: no sm_120 GPU visible";
+            c.error = n == 0 ? "gpu auto: no GPU is visible" : "gpu auto: no sm_" + std::to_string(BASALT_BUILT_SM) + " GPU visible";
             return c;
         }
         int best = main_ok[0];
@@ -192,7 +205,7 @@ GpuChoice choose_gpus(const GpuSpec& spec, const std::vector<GpuCard>& visible,
         for (int i : peer_ok)
             c.cards.push_back(i);
         for (int i : peer_ok)
-            if (i != best) c.notes.push_back("gpu auto: " + gpu_label(visible, i) + " is not sm_120, using it as an expert-tier peer only");
+            if (i != best) c.notes.push_back("gpu auto: " + gpu_label(visible, i) + " is not sm_" + std::to_string(BASALT_BUILT_SM) + ", using it as an expert-tier peer only");
         return c;
     }
     if (spec.kind == GpuSpec::Kind::Unset) {
diff --git a/tests/program/gpu_select_test.cpp b/tests/program/gpu_select_test.cpp
