+#ifndef BASALT_BUILT_SM
+#define BASALT_BUILT_SM 120
+#endif
+#define BUILT_SM_STR_(x) #x
+#define BUILT_SM_STR_X(x) BUILT_SM_STR_(x)
+#define BUILT_SM_STR BUILT_SM_STR_X(BASALT_BUILT_SM)
