From 1beba9a6e181f3cccbbad0b952c39aeba64c1545 Mon Sep 17 00:00:00 2001
From: Sparkstone (Zoros) <sparkstone@users.noreply.github.com>
Date: Sat, 21 Nov 2026 20:55:26 +0000
Subject: [PATCH 4/5] vision: portable CPU GEMM tile for non-x86 hosts

gemm_cpu.cpp keeps its AVX2 tile on x86 and gains a plain C++ tile with the
same 8-lane partial sums elsewhere (the compiler vectorizes it to NEON).
gemm_cpu_portable.cpp stands in for the AVX-512 BF16 file: cpu_has_bf16() is
false, so gemm_bf16w() takes the fp32 tile.
---
 src/vision/gemm_cpu.cpp          | 31 ++++++++++++++++++++++++++++++-
 src/vision/gemm_cpu_portable.cpp | 14 ++++++++++++++
 tools/vision/CMakeLists.txt      | 15 ++++++++++++---
 3 files changed, 56 insertions(+), 4 deletions(-)
 create mode 100644 src/vision/gemm_cpu_portable.cpp

diff --git a/src/vision/gemm_cpu.cpp b/src/vision/gemm_cpu.cpp
index b660a23..4923685 100644
--- a/src/vision/gemm_cpu.cpp
+++ b/src/vision/gemm_cpu.cpp
@@ -1,9 +1,15 @@
-// src/vision/gemm_cpu.cpp - see gemm_cpu.hpp.  AVX2 + FMA: a 4 x 4 register tile, bf16 widened by a shift.
+// src/vision/gemm_cpu.cpp - see gemm_cpu.hpp.  AVX2 + FMA: a 4 x 4 register tile, bf16 widened by a shift. Off x86
+// (AArch64: GB10 / DGX Spark) the same tile in plain C++ with 8 partial sums per product, which the compiler vectorizes.
 #include "gemm_cpu.hpp"
 
 #include <algorithm>
 #include <cstring>
+#if defined(__x86_64__) || defined(_M_X64)
 #include <immintrin.h>
+#define BASALT_GEMM_AVX2 1
+#else
+#define BASALT_GEMM_AVX2 0
+#endif
 #include <thread>
 #include <vector>
 
@@ -19,6 +25,7 @@ inline float bf16_round(float f) {
     return f;
 }
 
+#if BASALT_GEMM_AVX2
 inline float hsum(__m256 v) {
     __m128 a = _mm_add_ps(_mm256_castps256_ps128(v), _mm256_extractf128_ps(v, 1));
     a = _mm_add_ps(a, _mm_movehl_ps(a, a));
@@ -46,6 +53,28 @@ void tile(const float* X, const float* wf, float* Y, int m0, int rows, int n0, i
             Y[(size_t) (m0 + i) * N + n0 + j] = s;
         }
 }
+#else
+// Y rows [m0,m0+rows) x columns [n0, n0+4): the AVX2 tile's arithmetic, 8 lanes of partial sums per product
+void tile(const float* X, const float* wf, float* Y, int m0, int rows, int n0, int ncols, int N, int K) {
+    float acc[4][4][8] = {};
+    int k = 0;
+    for (; k + 8 <= K; k += 8)
+        for (int i = 0; i < rows; ++i) {
+            const float* xv = X + (size_t) (m0 + i) * K + k;
+            for (int j = 0; j < 4; ++j) {
+                const float* w = wf + (size_t) j * K + k;
+                for (int l = 0; l < 8; ++l) acc[i][j][l] += xv[l] * w[l];
+            }
+        }
+    for (int i = 0; i < rows; ++i)
+        for (int j = 0; j < ncols; ++j) {
+            const float* a = acc[i][j];
+            float s = ((a[0] + a[4]) + (a[2] + a[6])) + ((a[1] + a[5]) + (a[3] + a[7]));
+            for (int kk = k; kk < K; ++kk) s += X[(size_t) (m0 + i) * K + kk] * wf[(size_t) j * K + kk];
+            Y[(size_t) (m0 + i) * N + n0 + j] = s;
+        }
+}
+#endif
 
 template <class LoadRow>
 void run(const float* X, float* Y, int M, int N, int K, int threads, LoadRow load) {
diff --git a/src/vision/gemm_cpu_portable.cpp b/src/vision/gemm_cpu_portable.cpp
new file mode 100644
index 0000000..7f87b4d
--- /dev/null
+++ b/src/vision/gemm_cpu_portable.cpp
@@ -0,0 +1,14 @@
+// src/vision/gemm_cpu_portable.cpp - the AVX-512 BF16 path's entry points on a host without it (AArch64: GB10).
+// cpu_has_bf16() is false, so gemm_bf16w() takes its portable fp32 tile and never calls gemm_bf16_avx512().
+#include "gemm_cpu.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+
+namespace basalt::vision {
+bool cpu_has_bf16() { return false; }
+void gemm_bf16_avx512(const float*, const uint16_t*, float*, int, int, int, int) {
+    std::fprintf(stderr, "basalt: gemm_bf16_avx512 called on a non-x86 build\n");
+    std::abort();
+}
+}  // namespace basalt::vision
diff --git a/tools/vision/CMakeLists.txt b/tools/vision/CMakeLists.txt
index 8906e35..899d9cf 100644
--- a/tools/vision/CMakeLists.txt
+++ b/tools/vision/CMakeLists.txt
@@ -31,10 +31,19 @@ add_library(vision_core STATIC
   ${VISION_ROOT}/src/vision/mrope_positions.cpp
   ${VISION_ROOT}/src/vision/mmproj.cpp
   ${VISION_ROOT}/src/vision/encoder_cpu.cpp
-  ${VISION_ROOT}/src/vision/gemm_cpu.cpp
-  ${VISION_ROOT}/src/vision/gemm_cpu_avx512.cpp)
+  ${VISION_ROOT}/src/vision/gemm_cpu.cpp)
+# the AVX-512 BF16 product on x86; elsewhere (AArch64: GB10) its entry points answer "absent"
+if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|amd64|i[3-6]86)$")
+  target_sources(vision_core PRIVATE ${VISION_ROOT}/src/vision/gemm_cpu_avx512.cpp)
+  set(_vision_x86 ON)
+else()
+  target_sources(vision_core PRIVATE ${VISION_ROOT}/src/vision/gemm_cpu_portable.cpp)
+  set(_vision_x86 OFF)
+endif()
 target_include_directories(vision_core PUBLIC ${VISION_ROOT}/include PRIVATE ${VISION_ROOT}/src/vision)
-if(MSVC)
+if(NOT _vision_x86)
+  # portable C++ only: nothing to add
+elseif(MSVC)
   # /arch: selects the baseline; the intrinsics used below are available to a function that uses them either way.
   set_source_files_properties(${VISION_ROOT}/src/vision/gemm_cpu.cpp PROPERTIES COMPILE_OPTIONS "/arch:AVX2")
   # the AVX-512 BF16 file is only called after a run-time CPU check
